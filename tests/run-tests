#!/usr/bin/env python3
"""Regression tests for the orchestrator plugin. No dependencies, no network.

    tests/run-tests            # everything
    tests/run-tests guard      # one suite: guard | bus | role | runs

Starts its own bus on a scratch port so it never touches a running one.
"""
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GUARD = os.path.join(ROOT, "hooks", "orchestrator-guard.py")
BUS = os.path.join(ROOT, "scripts", "agent-bus")
RUN_ROLE = os.path.join(ROOT, "scripts", "run-role")
PORT = int(os.environ.get("TEST_BUS_PORT", 8479))

passed = failed = 0


def ok(name, cond, detail=""):
    global passed, failed
    if cond:
        passed += 1
        print(f"  pass  {name}")
    else:
        failed += 1
        print(f"  FAIL  {name}" + (f"\n          {detail}" if detail else ""))


# ---------------------------------------------------------------- guard

def guard(payload, cwd):
    p = subprocess.run([sys.executable, GUARD], input=json.dumps(payload),
                       capture_output=True, text=True, timeout=20)
    return bool(p.stdout.strip())        # non-empty stdout == deny


def suite_guard():
    print("\nguard")
    tmp = tempfile.mkdtemp()
    os.makedirs(os.path.join(tmp, ".claude"), exist_ok=True)

    def style(name):
        with open(os.path.join(tmp, ".claude", "settings.local.json"), "w") as fh:
            json.dump({"outputStyle": name}, fh)

    def bash(cmd, agent=None):
        e = {"cwd": tmp, "tool_name": "Bash", "tool_input": {"command": cmd}}
        if agent:
            e["agent_id"] = agent
        return guard(e, tmp)

    def write(path, agent=None):
        e = {"cwd": tmp, "tool_name": "Write", "tool_input": {"file_path": path}}
        if agent:
            e["agent_id"] = agent
        return guard(e, tmp)

    # plugin output styles are namespaced; a bare-name check silently disables the
    # guard for every plugin install, which is the only supported install path
    style("orchestrator:Orchestrator")
    ok("namespaced plugin style still enforces", write("app/x.php"))
    ok("namespaced style still allows specs", not write("docs/specs/p.md"))

    # inert unless the style is active — this is what keeps it out of normal sessions
    style("Default")
    ok("inert under Default style", not write("app/x.php"))
    ok("inert under Default style (bash)", not bash("rm -rf app/"))

    style("Orchestrator")

    # subagents implement; the guard must never touch them
    ok("subagent may write source", not write("app/x.php", agent="sub-1"))
    ok("subagent may run mutating git", not bash("git commit -m x", agent="sub-1"))

    # a run-role harness is a top-level session with no agent_id, so it needs its
    # own exemption — without it the guard silently blocks all delegated writes
    env = dict(os.environ, ORCHESTRATOR_DELEGATE="ui-developer")
    p = subprocess.run([sys.executable, GUARD],
                       input=json.dumps({"cwd": tmp, "tool_name": "Write",
                                         "tool_input": {"file_path": "ui/dashboard.html"}}),
                       capture_output=True, text=True, timeout=20, env=env)
    ok("delegated harness may write source", not p.stdout.strip(), p.stdout[:120])

    # the core rule
    ok("denies source write", write("app/v3/OrderReport.php"))
    ok("denies unrelated docs write", write("docs/other.md"))
    ok("allows spec write", not write("docs/specs/plan.md"))
    ok("allows review write", not write("docs/reviews/wave-1.md"))

    # shell paths around the rule
    for cmd in ("git commit -m x", "git push origin HEAD", "git checkout -b f",
                "git stash", "echo x > app/y.php", "sed -i '' s/a/b/ app/x.php",
                "rm -rf app/models", "mv app/a.php app/b.php", "tee app/out.php",
                "git status && rm -rf app/", "chmod +x scripts/deploy.sh"):
        ok(f"denies: {cmd}", bash(cmd))

    for cmd in ("git status --short", "git diff --stat", "git log --oneline -5",
                "git rev-list --count master..HEAD", "grep -rn \"rm\" app/",
                "tail -n 50 /tmp/x.log", "mkdir -p docs/specs",
                "php artisan test --filter=X", "git diff | head -20",
                "node c.mjs --json > docs/reviews/w1.json",
                "echo note >> docs/specs/plan.md"):
        ok(f"allows: {cmd}", not bash(cmd))

    # the explicit, visible escape hatch for an authorised commit
    ok("escape hatch permits commit", not bash("ORCHESTRATOR_COMMIT=1 git commit -m spec"))
    ok("escape hatch is not implicit", bash("git commit -m spec"))


# ---------------------------------------------------------------- bus

def api(path, payload=None, timeout=30):
    url = f"http://127.0.0.1:{PORT}{path}"
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def suite_bus():
    print("\nbus")
    tmp = tempfile.mkdtemp()
    subprocess.run(["git", "init", "-q"], cwd=tmp, timeout=20)
    proc = subprocess.Popen([sys.executable, BUS, "serve", "--port", str(PORT),
                             "--session", "TEST"], cwd=tmp,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        for _ in range(50):
            try:
                api("/health", timeout=2)
                break
            except (urllib.error.URLError, OSError):
                time.sleep(0.2)
        else:
            ok("bus starts", False, "never became healthy")
            return

        ok("bus starts", True)

        a = api("/register", {"name": "orchestrator"})
        b = api("/register", {"name": "developer"})
        ok("register issues a token", bool(a.get("token")) and a["token"] != b.get("token"))

        # identity comes from the token, not from what the caller claims
        api("/send", {"token": b["token"], "to": "all", "msg": "hi",
                      "from": "orchestrator"})
        msgs = api("/read", {"token": a["token"]})["messages"]
        ok("identity is issued, not claimed",
           msgs[-1]["from"] == "developer", f"got {msgs[-1]['from']}")

        ok("forged token rejected",
           "error" in api("/send", {"token": "BOGUS", "msg": "x"}))

        ok("loop guard trips at max hops",
           "error" in api("/send", {"token": a["token"], "msg": "x", "hops": 99}))

        # cursor must be the last message number, not a count of matches
        r = api("/read", {"token": b["token"]})
        cur = r["cursor"]
        ok("cursor is a message number", cur >= len(r["messages"]))

        # waiting from the current cursor must not re-deliver
        w = api("/wait", {"token": b["token"], "since": cur, "timeout": 2}, timeout=20)
        ok("wait does not re-deliver seen messages",
           w["messages"] == [] and w.get("timeout") is True)

        # and must wake on a genuinely new message
        got = {}

        def waiter():
            got["r"] = api("/wait", {"token": b["token"], "since": cur, "timeout": 20},
                           timeout=30)
        t = threading.Thread(target=waiter)
        t.start()
        time.sleep(1.5)
        api("/send", {"token": a["token"], "to": "developer", "msg": "wake up"})
        t.join(timeout=25)
        ok("wait wakes on a new message",
           bool(got.get("r", {}).get("messages")), str(got.get("r")))

        # doctor is slow; /status must offer a fast path
        t0 = time.time()
        s = api("/status?doctor=0", timeout=15)
        ok("status?doctor=0 is fast", (time.time() - t0) < 3.0,
           f"{time.time()-t0:.1f}s")
        ok("status carries harnesses and roles",
           "harnesses" in s and "roles" in s)

        # the dashboard must resolve relative to the plugin, not to the ~/.claude/bin
        # symlink the bus is normally invoked through
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/", timeout=10) as r:
            page = r.read().decode("utf-8", "replace")
        # assert behaviour, not branding — the previous marker was the old
        # dashboard's title and broke the moment the page was redesigned
        ok("serves the real dashboard, not the placeholder",
           "No dashboard installed" not in page
           and "<!DOCTYPE html>" in page
           and "/status" in page
           and len(page) > 10000,
           f"{len(page)} bytes: {page[:90]}")

        # MCP surface
        m = api("/mcp", {"jsonrpc": "2.0", "id": 1, "method": "tools/list"})
        names = {t["name"] for t in m["result"]["tools"]}
        ok("mcp exposes chat tools",
           {"chat_register", "chat_send", "chat_read", "chat_wait"} <= names,
           str(names))
    finally:
        proc.terminate()
        proc.wait(timeout=10)


# ---------------------------------------------------------------- runs
# Own suite, not an extension of bus: pause/resume spawn a child and must
# tear it down even when an assertion fails. Mixing that into suite_bus
# would leak a stopped process if an earlier bus check returned early.

def _reap(proc):
    if proc is None:
        return
    if proc.poll() is None:
        try:
            os.kill(proc.pid, signal.SIGCONT)
        except OSError:
            pass
        proc.terminate()
        try:
            proc.wait(timeout=5)
            return
        except subprocess.TimeoutExpired:
            pass
        proc.kill()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass


def _file_size(path):
    try:
        return os.path.getsize(path)
    except OSError:
        return 0


def _wait_size(path, minimum, timeout=5.0):
    deadline = time.time() + timeout
    n = _file_size(path)
    while time.time() < deadline:
        n = _file_size(path)
        if n >= minimum:
            return n
        time.sleep(0.05)
    return n


def _bus_up(cwd):
    """Start a bus on the scratch port against `cwd`, or None if it never answers."""
    proc = subprocess.Popen([sys.executable, BUS, "serve", "--port", str(PORT),
                             "--session", "TEST"], cwd=cwd,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):
        try:
            api("/health", timeout=2)
            return proc
        except (urllib.error.URLError, OSError):
            time.sleep(0.2)
    _reap(proc)
    return None


def _run_where(**match):
    """The newest run matching every field, or {} — /runs lists newest last."""
    for r in reversed(api("/runs")["runs"]):
        if all(r.get(k) == v for k, v in match.items()):
            return r
    return {}


def _stages(run):
    return [s.get("stage") for s in run.get("stages") or []]


def _dead_port():
    """A port nothing is listening on, so a bus call there is refused outright."""
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


def _frozen(path, samples=6, gap=0.1):
    """Sizes of `path` sampled over time — all equal means the writer is stopped."""
    out = []
    for _ in range(samples):
        out.append(_file_size(path))
        time.sleep(gap)
    return out


def suite_runs():
    print("\nruns")
    tmp = tempfile.mkdtemp()
    subprocess.run(["git", "init", "-q"], cwd=tmp, timeout=20)
    tick = os.path.join(tmp, "ticks")
    children = []
    proc = subprocess.Popen([sys.executable, BUS, "serve", "--port", str(PORT),
                             "--session", "TEST"], cwd=tmp,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        for _ in range(50):
            try:
                api("/health", timeout=2)
                break
            except (urllib.error.URLError, OSError):
                time.sleep(0.2)
        else:
            ok("bus starts", False, "never became healthy")
            return

        ok("bus starts", True)

        listed = api("/runs")
        ok("GET /runs is empty before any open",
           listed.get("ok") is True and listed.get("runs") == [],
           str(listed))

        # richer register must not weaken identity: token stamps `from`
        a = api("/register", {"name": "orchestrator"})
        b = api("/register", {"name": "developer", "role": "developer",
                              "harness": "claude", "model": "opus"})
        api("/send", {"token": b["token"], "to": "all", "msg": "hi",
                      "from": "orchestrator"})
        msgs = api("/read", {"token": a["token"]})["messages"]
        ok("register extras do not let a claimed from win",
           msgs[-1]["from"] == "developer", f"got {msgs[-1]['from']}")

        opened = api("/runs", {"title": "wave-1 coverage", "role": "developer",
                               "harness": "claude", "model": "opus"})
        rid = opened.get("id")
        run = opened.get("run") or {}
        ok("POST /runs returns an id", bool(rid), str(opened))
        ok("open records title/role/harness/model",
           run.get("title") == "wave-1 coverage"
           and run.get("role") == "developer"
           and run.get("harness") == "claude"
           and run.get("model") == "opus",
           str(run))
        ok("open state is running", run.get("state") == "running", str(run))

        api(f"/runs/{rid}/stage", {"stage": "intent"})
        api(f"/runs/{rid}/stage", {"stage": "implement", "note": "working"})
        staged = api("/runs")["runs"][-1]
        stages = staged.get("stages") or []
        ok("stages accumulate in order",
           [s.get("stage") for s in stages] == ["intent", "implement"]
           and stages[1].get("note") == "working",
           str(stages))
        ok("stages carry ordered timestamps",
           len(stages) == 2
           and all(s.get("ts") for s in stages)
           and stages[0]["ts"] <= stages[1]["ts"],
           str(stages))

        # no closed runs yet — a fraction, not a fabricated percentage
        rate0 = api("/status?doctor=0")["successRate"]
        ok("successRate is {complete, closed} before any close",
           isinstance(rate0, dict)
           and rate0.get("complete") == 0
           and rate0.get("closed") == 0
           and not isinstance(rate0, (int, float)),
           str(rate0))

        closed = api(f"/runs/{rid}/close", {"outcome": "complete", "exit_code": 0})
        crun = closed.get("run") or {}
        ok("close records outcome and exit code",
           crun.get("outcome") == "complete"
           and crun.get("state") == "complete"
           and crun.get("exit_code") == 0,
           str(crun))
        ok("duration derives from opened/closed",
           bool(crun.get("opened")) and bool(crun.get("closed"))
           and crun["closed"] >= crun["opened"],
           f"opened={crun.get('opened')} closed={crun.get('closed')}")

        rate1 = api("/status?doctor=0")["successRate"]
        ok("successRate counts a complete close as 1/1",
           rate1 == {"complete": 1, "closed": 1}, str(rate1))

        fail_id = api("/runs", {"title": "will fail"})["id"]
        api(f"/runs/{fail_id}/close", {"outcome": "failed", "exit_code": 2})
        rate2 = api("/status?doctor=0")["successRate"]
        ok("successRate is a real fraction over closed runs",
           rate2 == {"complete": 1, "closed": 2}, str(rate2))

        s = api("/status?doctor=0")
        missing = [k for k in ("ok", "session", "channel", "roles", "default",
                               "harnesses", "doctor", "agents", "messageCount",
                               "cursor") if k not in s]
        ok("status keeps the existing contract", not missing, f"missing {missing}")
        ok("status carries runs",
           isinstance(s.get("runs"), dict)
           and "counts" in s["runs"] and "open" in s["runs"],
           str(s.get("runs")))
        rich = next((x for x in s.get("agents") or []
                     if x.get("name") == "developer"), None)
        ok("status agents carry declared role/harness/model",
           rich is not None
           and rich.get("role") == "developer"
           and rich.get("harness") == "claude"
           and rich.get("model") == "opus"
           and "idle_s" in rich,
           str(rich))

        # live child: append one byte, flush, sleep. SIGSTOP must freeze it.
        child = subprocess.Popen(
            [sys.executable, "-c",
             "import os,sys,time\n"
             "fd=os.open(sys.argv[1], os.O_WRONLY|os.O_CREAT|os.O_APPEND)\n"
             "while True:\n"
             "    os.write(fd, b'x')\n"
             "    time.sleep(0.1)\n",
             tick],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)
        children.append(child)

        live = api("/runs", {"title": "ticker", "pid": child.pid})
        lid = live.get("id")
        grew = _wait_size(tick, 2)
        ok("ticker is writing", grew >= 2, f"size {grew}")

        # urllib sends GET when there is no body — that must not pause
        get_code = None
        try:
            sneak = api(f"/runs/{lid}/pause")
            get_detail = f"GET returned 200 {sneak}"
        except urllib.error.HTTPError as exc:
            get_code = exc.code
            get_detail = f"HTTP {exc.code}"
        ok("GET /runs/<id>/pause does not succeed",
           get_code == 404, get_detail)
        after_get = _wait_size(tick, grew + 1)
        ok("GET pause does not freeze the process",
           after_get > grew, f"{grew} -> {after_get}")

        paused = api(f"/runs/{lid}/pause", {})
        ok("POST pause records paused",
           paused.get("ok") is True
           and (paused.get("run") or {}).get("state") == "paused",
           str(paused))
        frozen = _file_size(tick)
        samples = []
        for _ in range(6):
            samples.append(_file_size(tick))
            time.sleep(0.1)
        ok("pause freezes the process",
           len(set(samples)) == 1 and samples[0] == frozen,
           f"sizes {samples}")

        resumed = api(f"/runs/{lid}/resume", {})
        ok("POST resume records running",
           resumed.get("ok") is True
           and (resumed.get("run") or {}).get("state") == "running",
           str(resumed))
        unfrozen = _wait_size(tick, frozen + 1)
        ok("resume unfreezes the process",
           unfrozen > frozen, f"{frozen} -> {unfrozen}")

        rate_open = api("/status?doctor=0")["successRate"]
        ok("successRate ignores still-open runs",
           rate_open == {"complete": 1, "closed": 2}, str(rate_open))
        api(f"/runs/{lid}/close", {"outcome": "complete", "exit_code": 0})

        # a reaped pid must not crash the server or flip state
        dead = subprocess.Popen([sys.executable, "-c", "pass"])
        dead.wait(timeout=10)
        gone = api("/runs", {"title": "already dead", "pid": dead.pid})
        gid = gone.get("id")
        bad = api(f"/runs/{gid}/pause", {})
        ok("dead pid returns a clean error",
           "error" in bad and bad.get("ok") is not True, str(bad))
        gone_run = next((r for r in api("/runs")["runs"] if r.get("id") == gid),
                        {})
        ok("dead pid does not flip run state",
           gone_run.get("state") == "running", str(gone_run))
        health = api("/health")
        ok("server answers /health after a dead pid",
           health.get("ok") is True, str(health))

        # ---- pid attached after open
        # bash learns its child's pid only after starting it, and a run id
        # exported after the child starts is not inherited by it. So the run has
        # to be openable with no pid and completable afterwards.
        late = api("/runs", {"title": "attach later", "role": "developer"})
        late_id = late.get("id")
        ok("a run opens with no pid",
           bool(late_id) and "pid" not in (late.get("run") or {}), str(late))

        att = api(f"/runs/{late_id}/pid", {"pid": child.pid})
        ok("POST pid attaches the pid",
           att.get("ok") is True
           and (att.get("run") or {}).get("pid") == child.pid, str(att))
        ok("an attached pid shows up in GET /runs",
           _run_where(id=late_id).get("pid") == child.pid,
           str(_run_where(id=late_id)))

        # every refusal must also leave the run exactly as it was — an error
        # reply is worth nothing if the pid was recorded anyway
        snap = _run_where(id=late_id)
        for label, path, payload in (
                ("an unknown run id", "/runs/nosuchrun/pid", {"pid": child.pid}),
                ("a missing pid", f"/runs/{late_id}/pid", {}),
                ("a null pid", f"/runs/{late_id}/pid", {"pid": None}),
                ("a non-integer pid", f"/runs/{late_id}/pid", {"pid": "not-a-pid"}),
                # kill(0, sig) signals the whole process group
                ("pid 0", f"/runs/{late_id}/pid", {"pid": 0})):
            reply = api(path, payload)
            after = _run_where(id=late_id)
            ok(f"refuses {label}, leaving the run unchanged",
               "error" in reply and reply.get("ok") is not True and after == snap,
               f"reply {reply} / run {after}")

        for outcome in ("complete", "failed"):
            shut = api("/runs", {"title": f"closed {outcome} before pid"})
            api(f"/runs/{shut['id']}/close", {"outcome": outcome, "exit_code": 0})
            reply = api(f"/runs/{shut['id']}/pid", {"pid": child.pid})
            ok(f"refuses a pid on an already-{outcome} run",
               "error" in reply and f"already {outcome}" in str(reply.get("error"))
               and "pid" not in _run_where(id=shut["id"]),
               f"reply {reply} / run {_run_where(id=shut['id'])}")

        # the ticker must be observed still writing first: a freeze assertion
        # over a process that already died passes for the wrong reason
        pre = _file_size(tick)
        alive = _wait_size(tick, pre + 1)
        paused2 = api(f"/runs/{late_id}/pause", {})
        ok("POST pause records paused for an attached pid",
           paused2.get("ok") is True
           and (paused2.get("run") or {}).get("state") == "paused", str(paused2))
        held = _frozen(tick)
        api(f"/runs/{late_id}/resume", {})
        thawed = _wait_size(tick, held[-1] + 1)
        ok("an attached pid really freezes and thaws the process",
           alive > pre and len(set(held)) == 1 and thawed > held[-1],
           f"{pre} -> {alive}, held {held}, then {thawed}")

        # the pid must come back from the JSONL, not merely from memory
        _reap(proc)
        proc = _bus_up(tmp)
        if proc is None:
            ok("bus restarts on the same directory", False, "never became healthy")
            return
        replayed = _run_where(id=late_id)
        ok("an attached pid survives a bus restart",
           replayed.get("pid") == child.pid and replayed.get("state") == "running",
           str(replayed))

        pre = _file_size(tick)
        alive = _wait_size(tick, pre + 1)
        api(f"/runs/{late_id}/pause", {})
        held = _frozen(tick)
        api(f"/runs/{late_id}/resume", {})
        thawed = _wait_size(tick, held[-1] + 1)
        ok("a replayed pid still freezes and thaws the process",
           alive > pre and len(set(held)) == 1 and thawed > held[-1],
           f"{pre} -> {alive}, held {held}, then {thawed}")
    finally:
        for child in children:
            _reap(child)
        _reap(proc)
        shutil.rmtree(tmp, ignore_errors=True)


# ---------------------------------------------------------------- run-role

def suite_role():
    print("\nrun-role")
    p = subprocess.run([RUN_ROLE], capture_output=True, text=True, timeout=20)
    ok("usage without args", "usage: run-role" in p.stderr)
    ok("lists available roles", "verifier" in p.stderr, p.stderr[:200])

    p = subprocess.run([RUN_ROLE, "nosuch", "--harness", "pi", "--", "x"],
                       capture_output=True, text=True, timeout=20)
    ok("rejects unknown role", "no such role" in p.stderr)

    p = subprocess.run([RUN_ROLE, "developer", "--harness", "claude", "--", "x"],
                       capture_output=True, text=True, timeout=20)
    ok("claude harness points at the Agent tool",
       "subagent_type" in p.stderr and "orchestrator:developer" in p.stderr)

    p = subprocess.run([RUN_ROLE, "developer", "--harness", "nope", "--", "x"],
                       capture_output=True, text=True, timeout=20)
    ok("rejects unknown harness", "unknown harness" in p.stderr)

    # isolation must be opt-in: no worktree unless asked for
    tmp = tempfile.mkdtemp()
    subprocess.run(["git", "init", "-q"], cwd=tmp, timeout=20)
    open(os.path.join(tmp, "a.txt"), "w").write("x")
    for c in (["git", "add", "-A"],
              ["git", "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "i"]):
        subprocess.run(c, cwd=tmp, timeout=20)

    def worktrees():
        r = subprocess.run(["git", "worktree", "list"], cwd=tmp,
                           capture_output=True, text=True, timeout=20)
        return len(r.stdout.strip().splitlines())

    subprocess.run([RUN_ROLE, "developer", "--harness", "claude", "--", "x"],
                   cwd=tmp, capture_output=True, text=True, timeout=30)
    ok("no worktree without the flag", worktrees() == 1, f"{worktrees()} worktrees")

    p = subprocess.run([RUN_ROLE, "developer", "--harness", "claude", "--worktree", "--", "x"],
                       cwd=tmp, capture_output=True, text=True, timeout=40)
    ok("--worktree creates one", worktrees() == 2, f"{worktrees()} worktrees")
    ok("--worktree reports its base ancestry",
       "cut from" in p.stderr and "merge orchestrator/" in p.stderr, p.stderr[:200])

    # every role carries a short reminder, repeated at the end of the role and the
    # brief — instructions given once lose influence as a session grows
    import re as _re
    for role in ("developer", "ui-developer", "verifier"):
        fm = open(os.path.join(ROOT, "agents", f"{role}.md")).read()
        m = _re.match(r"^---\n(.*?)\n---", fm, _re.S)
        ok(f"{role} has a roleReminder",
           bool(m) and "roleReminder:" in m.group(1))

    # role bodies must survive frontmatter stripping
    for role in ("developer", "ui-developer", "verifier"):
        f = os.path.join(ROOT, "agents", f"{role}.md")
        body = open(f).read().split("---", 2)[-1].strip()
        ok(f"{role} has a body after frontmatter", len(body) > 400, f"{len(body)} chars")

    role_provenance()


# ------------------------------------------------------- run-role provenance
# What run-role leaves behind: a run on the bus that says how the delegation
# went, and an environment the harness can read its own identity out of. Both
# are checked against a fake harness, so no model is ever invoked — and every
# assertion reads a real process or a real bus record, never the script text.

FAKE_HARNESS = """#!/bin/sh
# Stands in for codex. Records what run-role handed it, then exits as asked.
env > "$FAKE_ENV_FILE"
echo $$ > "$FAKE_PID_FILE"
echo fake-harness-stdout
echo fake-harness-stderr >&2
exit ${FAKE_EXIT:-0}
"""


def role_provenance():
    tmp = tempfile.mkdtemp()
    subprocess.run(["git", "init", "-q"], cwd=tmp, timeout=20)
    home = os.path.join(tmp, "home")
    bindir = os.path.join(tmp, "bin")
    os.makedirs(home)
    os.makedirs(bindir)
    fake = os.path.join(bindir, "codex")
    with open(fake, "w") as fh:
        fh.write(FAKE_HARNESS)
    os.chmod(fake, 0o755)
    envfile = os.path.join(tmp, "harness-env")
    pidfile = os.path.join(tmp, "harness-pid")
    # /usr/bin and /bin carry python3, curl, git and awk but no real harness, so
    # the only one reachable is ours. An empty HOME keeps the model registry out.
    path = f"{bindir}:/usr/bin:/bin"

    def delegate(args, port=PORT, exit_code=0):
        for f in (envfile, pidfile):
            if os.path.exists(f):
                os.unlink(f)
        # a minimal env, so an ORCHESTRATOR_* the harness sees can only have come
        # from run-role — inheriting the suite's env would prove nothing
        env = {"PATH": path, "HOME": home, "TMPDIR": tempfile.gettempdir(),
               "AGENT_BUS_PORT": str(port), "FAKE_ENV_FILE": envfile,
               "FAKE_PID_FILE": pidfile, "FAKE_EXIT": str(exit_code)}
        return subprocess.run([RUN_ROLE] + args, cwd=tmp, env=env,
                              capture_output=True, text=True, timeout=60)

    def harness_env():
        out = {}
        try:
            with open(envfile) as fh:
                for line in fh:
                    if line.startswith("ORCHESTRATOR_"):
                        k, _, v = line.rstrip("\n").partition("=")
                        out[k] = v
        except OSError:
            pass
        return out

    def harness_pid():
        try:
            with open(pidfile) as fh:
                return int(fh.read().strip())
        except (OSError, ValueError):
            return 0

    proc = _bus_up(tmp)
    try:
        if proc is None:
            ok("bus starts for run-role", False, "never became healthy")
            return
        ok("bus starts for run-role", api("/runs")["runs"] == [],
           "port already carries runs — a stale bus is answering")

        # ---- a delegation that succeeds
        title = "wave3 fake delegation succeeds"
        good = delegate(["developer", "--harness", "codex",
                         "--model", "test-model-x", "--", title])
        run = _run_where(title=title)
        ok("a successful delegation stages running then complete",
           _stages(run) == ["running", "complete"], f"rc={good.returncode} {run}")
        ok("a successful delegation closes complete, exit 0",
           good.returncode == 0 and run.get("state") == "complete"
           and run.get("outcome") == "complete" and run.get("exit_code") == 0,
           f"rc={good.returncode} {run}")
        ok("run-role attaches the launched harness pid to the run",
           harness_pid() > 0 and run.get("pid") == harness_pid(),
           f"harness reported {harness_pid()}, run carries {run.get('pid')}")

        seen = harness_env()
        ok("the harness inherits role, harness, model, bus and delegate",
           {k: seen.get(k) for k in ("ORCHESTRATOR_ROLE", "ORCHESTRATOR_HARNESS",
                                     "ORCHESTRATOR_MODEL", "ORCHESTRATOR_BUS",
                                     "ORCHESTRATOR_DELEGATE")}
           == {"ORCHESTRATOR_ROLE": "developer",
               "ORCHESTRATOR_HARNESS": "codex",
               "ORCHESTRATOR_MODEL": "test-model-x",
               "ORCHESTRATOR_BUS": f"http://127.0.0.1:{PORT}",
               "ORCHESTRATOR_DELEGATE": "developer"},
           str(seen))
        ok("ORCHESTRATOR_RUN_ID is the run the bus actually opened",
           bool(run.get("id")) and seen.get("ORCHESTRATOR_RUN_ID") == run.get("id"),
           f"harness saw {seen.get('ORCHESTRATOR_RUN_ID')!r}, bus opened {run.get('id')!r}")

        # empty means "the harness is on its own default"; a guess would be worse
        title = "wave3 delegation with no model"
        delegate(["developer", "--harness", "codex", "--", title])
        seen = harness_env()
        ok("ORCHESTRATOR_MODEL is set and empty when no model resolves",
           seen.get("ORCHESTRATOR_MODEL") == ""
           and "ORCHESTRATOR_MODEL" in seen, str(seen))

        # ---- a delegation that fails
        title = "wave3 fake delegation fails"
        bad = delegate(["developer", "--harness", "codex",
                        "--model", "test-model-x", "--", title], exit_code=7)
        run = _run_where(title=title)
        ok("a failing delegation stages running then failed",
           _stages(run) == ["running", "failed"], f"rc={bad.returncode} {run}")
        ok("a failing delegation propagates the harness exit code",
           bad.returncode == 7 and run.get("state") == "failed"
           and run.get("exit_code") == 7, f"rc={bad.returncode} {run}")

        # ---- delegations that never launch anything: recorded, not absent
        for label, args, code in (
                ("an unknown harness", ["--harness", "nope"], 64),
                ("the claude pointer", ["--harness", "claude"], 64)):
            title = f"wave3 blocked by {label}"
            p = delegate(["developer"] + args + ["--", title])
            run = _run_where(title=title)
            ok(f"{label} is recorded blocked and closed failed",
               p.returncode == code and _stages(run) == ["blocked"]
               and run.get("state") == "failed" and run.get("exit_code") == code
               and not os.path.exists(pidfile),
               f"rc={p.returncode} {run}")

        # pi is the one harness with a preflight check; PATH is ours, so its
        # absence is asserted rather than assumed
        title = "wave3 blocked by a missing pi"
        p = delegate(["developer", "--harness", "pi", "--", title])
        run = _run_where(title=title)
        ok("a missing harness binary is recorded blocked, exit 69",
           shutil.which("pi", path=path) is None and p.returncode == 69
           and _stages(run) == ["blocked"] and run.get("state") == "failed"
           and run.get("exit_code") == 69 and not os.path.exists(pidfile),
           f"rc={p.returncode} pi={shutil.which('pi', path=path)} {run}")

        # ---- a down bus must be invisible to the caller
        title = "wave3 delegation with the bus down"
        down = delegate(["developer", "--harness", "codex",
                         "--model", "test-model-x", "--", title],
                        port=_dead_port(), exit_code=7)
        ok("a down bus neither stops the harness nor changes its exit code",
           down.returncode == 7 and harness_pid() > 0
           and "fake-harness-stdout" in down.stdout and _run_where(title=title) == {},
           f"rc={down.returncode} out={down.stdout!r}")
        ok("a down bus prints nothing extra",
           down.stdout == bad.stdout and down.stderr == bad.stderr,
           f"stdout {bad.stdout!r} -> {down.stdout!r}; "
           f"stderr {bad.stderr!r} -> {down.stderr!r}")
    finally:
        _reap(proc)
        shutil.rmtree(tmp, ignore_errors=True)


SUITES = {"guard": suite_guard, "bus": suite_bus, "runs": suite_runs,
          "role": suite_role}

if __name__ == "__main__":
    # a live orchestrator session exports these; they must not leak into the suite
    os.environ.pop("ORCHESTRATOR_DELEGATE", None)
    os.environ.pop("ORCHESTRATOR_COMMIT", None)
    # run-role opens a run for every delegation, refusals included. Pointed at the
    # default port the suite would post its fixtures into a live session's bus.
    os.environ["AGENT_BUS_PORT"] = str(PORT)
    which = sys.argv[1:] or list(SUITES)
    for name in which:
        if name not in SUITES:
            print(f"unknown suite: {name}; have {', '.join(SUITES)}")
            sys.exit(2)
        SUITES[name]()
    print(f"\n{passed} passed, {failed} failed")
    sys.exit(1 if failed else 0)
