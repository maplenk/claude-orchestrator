#!/usr/bin/env bash
# Run a ROLE on a HARNESS. Roles and harnesses are orthogonal: one role
# definition, any model behind it.
#
#   run-role <role> --harness <codex|grok|pi> [--model M] [--read-only] -- <brief>
#
# Roles live in ~/.claude/agents/<role>.md and are injected as the system
# prompt, so `developer` behaves like `developer` regardless of which model is
# executing it.
#
# The `claude` harness is deliberately NOT handled here — in-process subagents
# are the Agent tool's job:  Agent(subagent_type: "orchestrator:developer", ...)
set -euo pipefail

# Roles resolve from your own ~/.claude/agents first, so you can override a
# packaged role without editing the plugin; the plugin's own agents/ is fallback.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)}"
USER_AGENTS="$HOME/.claude/agents"
PLUGIN_AGENTS="$PLUGIN_ROOT/agents"
THINKING="${RUN_ROLE_THINKING:-medium}"
ROLE="${1:-}"; shift || true
HARNESS=""; MODEL=""; READONLY=0; WORKTREE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --harness) HARNESS="$2"; shift 2 ;;
    --model)   MODEL="$2";   shift 2 ;;
    --read-only) READONLY=1; shift ;;
    --worktree) WORKTREE=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
BRIEF="$*"

if [[ -z "$ROLE" || -z "$HARNESS" || -z "$BRIEF" ]]; then
  echo "usage: run-role <role> --harness <codex|grok|pi> [--model M] [--read-only] [--worktree] -- <brief>" >&2
  echo "roles: $(ls "$USER_AGENTS" "$PLUGIN_AGENTS" 2>/dev/null | grep '\.md$' | sed 's/\.md$//' | sort -u | tr '\n' ' ')" >&2
  exit 64
fi

ROLE_FILE="$USER_AGENTS/$ROLE.md"
[[ -r "$ROLE_FILE" ]] || ROLE_FILE="$PLUGIN_AGENTS/$ROLE.md"
[[ -r "$ROLE_FILE" ]] || { echo "run-role: no such role: $ROLE (looked in $USER_AGENTS and $PLUGIN_AGENTS)" >&2; exit 66; }

# Model resolution: --model > registry modelByRole[<role>] > registry model.
# The role/harness pair picks the model, not the harness alone — e.g. pi runs
# Kimi for ui-developer and DeepSeek for everything else.
if [[ -z "$MODEL" ]]; then
  MODEL="$(python3 - "$HARNESS" "$ROLE" <<'PY' 2>/dev/null || true
import json, os, sys
harness, role = sys.argv[1], sys.argv[2]
try:
    reg = json.load(open(os.path.expanduser("~/.claude/orchestrator/harnesses.json")))
except (OSError, ValueError):
    sys.exit(0)
cfg = (reg.get("harnesses") or {}).get(harness) or {}
print((cfg.get("modelByRole") or {}).get(role) or cfg.get("model") or "")
PY
)"
fi

# Strip YAML frontmatter — the body is the role definition.
ROLE_BODY="$(awk 'BEGIN{n=0} /^---[[:space:]]*$/{n++; next} n>=2' "$ROLE_FILE")"
[[ -n "$ROLE_BODY" ]] || { echo "run-role: $ROLE_FILE has no body" >&2; exit 65; }

# Isolation is opt-in, never automatic: cutting a worktree changes where the
# agent's work lands, and that is the caller's decision to make explicitly.
if [[ $WORKTREE -eq 1 ]]; then
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "run-role: --worktree needs a git repo" >&2; exit 69; }
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  BASE_SHA="$(git rev-parse --short HEAD)"
  BASE_REF="$(git rev-parse --abbrev-ref HEAD)"
  WT_DIR="$REPO_ROOT/.claude/orchestrator/worktrees/$ROLE-$$"
  WT_BRANCH="orchestrator/$ROLE-$$"
  mkdir -p "$(dirname "$WT_DIR")"
  git worktree add -q -b "$WT_BRANCH" "$WT_DIR" HEAD || {
    echo "run-role: could not create worktree at $WT_DIR" >&2; exit 70; }
  cd "$WT_DIR" || exit 70
  # Verify the base by ancestry, not by name — a worktree cut from the wrong
  # lineage makes merge work silently resolve to no-ops.
  echo "run-role: worktree $WT_DIR" >&2
  echo "run-role: branch $WT_BRANCH cut from $BASE_REF @ $BASE_SHA" >&2
  echo "run-role: when finished — review it, then: git -C \"$REPO_ROOT\" merge $WT_BRANCH" >&2
  echo "run-role: remove with — git -C \"$REPO_ROOT\" worktree remove $WT_DIR" >&2
fi

# Mark this process tree as the implementor. The PreToolUse guard exempts
# subagents by agent_id, but a harness launched here is a top-level session with
# none — without this it would be treated as an orchestrator and blocked from
# writing anything.
export ORCHESTRATOR_DELEGATE="$ROLE"

# Native CLIs take their instructions from AGENTS.md in the working directory —
# verified against both codex and grok. This is how the role reaches a harness
# that is not Claude Code and has no --append-system-prompt.
install_role_file() {
  local dir="$1"
  if [[ -f "$dir/AGENTS.md" && ! -f "$dir/.orchestrator-agents-backup" ]]; then
    cp "$dir/AGENTS.md" "$dir/.orchestrator-agents-backup"
  fi
  printf '%s\n' "$ROLE_BODY" > "$dir/AGENTS.md"
}

echo "run-role: $ROLE on $HARNESS using ${MODEL:-<harness default>}" >&2

# Report this delegation as a run so the dashboard can show it and the
# bus can SIGSTOP the harness pid to pause. The harness stays a child —
# exec would replace us and leave the run open. Every bus call is
# best-effort: a down, slow, or erroring bus must not change the
# harness's exit code or print anything.
BUS_URL="http://127.0.0.1:${AGENT_BUS_PORT:-8477}"
RUN_ID=""
HARNESS_PID=""

bus_post() {
  curl -s --connect-timeout 1 -m 1 \
    -X POST "${BUS_URL}$1" \
    -H 'Content-Type: application/json' \
    -d "$2" 2>/dev/null || true
}

open_run() {
  local pid="$1" title payload resp
  title="${BRIEF%%$'\n'*}"
  if [[ ${#title} -gt 80 ]]; then
    title="${title:0:77}..."
  fi
  payload="$(python3 - "$title" "$ROLE" "$HARNESS" "${MODEL}" "$pid" <<'PY' 2>/dev/null || true
import json, sys
print(json.dumps({
    "title": sys.argv[1],
    "role": sys.argv[2],
    "harness": sys.argv[3],
    "model": sys.argv[4],
    "pid": int(sys.argv[5]),
}))
PY
)"
  [[ -n "$payload" ]] || return 0
  resp="$(bus_post /runs "$payload")"
  RUN_ID="$(printf '%s' "$resp" | python3 -c 'import json,sys
try:
    i = json.load(sys.stdin).get("id")
    print("" if i is None else i)
except Exception:
    pass' 2>/dev/null || true)"
}

stage_run() {
  [[ -n "$RUN_ID" ]] || return 0
  bus_post "/runs/${RUN_ID}/stage" "{\"stage\":\"$1\"}" >/dev/null
}

close_run() {
  local outcome="$1" code="$2"
  [[ -n "$RUN_ID" ]] || return 0
  bus_post "/runs/${RUN_ID}/close" "{\"outcome\":\"${outcome}\",\"exit_code\":${code}}" >/dev/null
  RUN_ID=""
}

on_signal() {
  trap '' INT TERM
  if [[ -n "${HARNESS_PID:-}" ]]; then
    kill -s "$1" "$HARNESS_PID" 2>/dev/null || true
    HARNESS_PID=""
  fi
  close_run failed "$2"
  exit "$2"
}
trap 'on_signal INT 130' INT
trap 'on_signal TERM 143' TERM

fail_run() {
  trap '' INT TERM
  open_run "$$"
  close_run failed "$1"
  exit "$1"
}

run_harness() {
  local ec
  "$@" &
  HARNESS_PID=$!
  open_run "$HARNESS_PID"
  stage_run running
  set +e
  wait "$HARNESS_PID"
  ec=$?
  set -e
  HARNESS_PID=""
  trap '' INT TERM
  if [[ $ec -eq 0 ]]; then
    close_run complete 0
  else
    close_run failed "$ec"
  fi
  exit "$ec"
}

case "$HARNESS" in
  codex)
    # Native codex CLI. Role arrives via AGENTS.md; model/effort come from
    # ~/.codex/config.toml unless pinned here.
    install_role_file "$PWD"
    CODEX_ARGS=(exec --skip-git-repo-check)
    [[ -n "$MODEL" ]] && CODEX_ARGS+=(-c "model=\"$MODEL\"")
    [[ $READONLY -eq 1 ]] && CODEX_ARGS+=(-c 'sandbox_permissions=["disk-full-read-access"]')
    run_harness codex "${CODEX_ARGS[@]}" "$BRIEF"
    ;;
  grok)
    # Native grok CLI. Role arrives via AGENTS.md; the default model and
    # reasoning effort come from ~/.grok/config.toml unless pinned here.
    install_role_file "$PWD"
    GROK_ARGS=(-p)
    [[ -n "$MODEL" ]] && GROK_ARGS=(--model "$MODEL" -p)
    run_harness grok "${GROK_ARGS[@]}" "$BRIEF"
    ;;
  pi)
    command -v pi >/dev/null || { echo "run-role: pi not on PATH" >&2; fail_run 69; }
    if [[ $READONLY -eq 1 ]]; then
      # --tools read is the only setting that actually holds: --exclude-tools
      # edit,write leaves bash in place and the model just redirects into files.
      run_harness pi -p --no-session --tools read --thinking "$THINKING" \
        --model "${MODEL:-moonshotai/Kimi-K3}" \
        --append-system-prompt "$ROLE_BODY" "$BRIEF"
    fi
    run_harness pi -p --no-session --thinking "$THINKING" \
      --model "${MODEL:-moonshotai/Kimi-K3}" \
      --append-system-prompt "$ROLE_BODY" "$BRIEF"
    ;;
  claude)
    echo "run-role: use the Agent tool for the claude harness:" >&2
    echo "  Agent(subagent_type: \"orchestrator:$ROLE\", isolation: \"worktree\", prompt: <brief>)" >&2
    fail_run 64
    ;;
  *)
    echo "run-role: unknown harness: $HARNESS" >&2
    fail_run 64
    ;;
esac
