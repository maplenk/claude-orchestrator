#!/usr/bin/env python3
"""Per-session message bus for orchestrator / implementor / verifier.

One server per Claude Code session, bound to 127.0.0.1 on an ephemeral port.
Speaks two protocols over the same store so every harness can reach it:

  MCP  (POST /mcp)   — Claude Code / Codex / anything MCP-capable
  REST (POST /send…) — headless harnesses that only have curl

  agent-bus serve --session <id> [--channel <name>]   # start (hooks do this)
  agent-bus info                                       # print handshake JSON
  agent-bus stop                                       # shut down

Design notes, and where this deliberately differs from agentchattr:

* **Long-poll, not keystroke injection.** You cannot wake an idle Claude Code
  subagent from outside — it is not a terminal, and it only exists while it is
  inside a tool call. So `chat_wait` blocks server-side until a message arrives.
  An agent that wants to be reachable calls it; that is the whole mechanism.
* **Identity is issued, not claimed.** `register` returns a token; the server
  maps token -> name and stamps every message itself. An agent cannot post as
  the orchestrator by passing a different `from`.
* **Loop guard.** Agent-to-agent chains carry a hop count and are refused past
  a limit, so two agents cannot ping-pong forever.

Storage is the same JSONL the `agent-board` CLI reads, so both work together.
"""
import argparse
import json
import os
import secrets
import signal
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse, parse_qs

MAX_HOPS = 6
DOCTOR_TTL = 60          # seconds; the doctor subprocess is slow, do not run it per request
DOCTOR_CACHE = [None, 0.0]
PROTOCOL = "2025-06-18"
LOCK = threading.Lock()
NEW_MSG = threading.Condition(LOCK)

STATE = {
    "session": None,
    "channel": "default",
    "path": None,
    "runs_path": None,
    "tokens": {},   # token -> agent name
    "seen": {},     # agent name -> last heartbeat ts
    "meta": {},     # agent name -> optional role/harness/model
    "runs": {},     # id -> folded run; in memory so /status never re-reads the JSONL
    "run_ids": [],  # insertion order, newest last
}


# ---------------------------------------------------------------- storage

def repo_root():
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return os.getcwd()


def bus_dir():
    d = os.path.join(repo_root(), ".claude", "orchestrator")
    os.makedirs(os.path.join(d, "board"), exist_ok=True)
    os.makedirs(os.path.join(d, "runs"), exist_ok=True)
    gi = os.path.join(d, ".gitignore")
    if not os.path.exists(gi):
        with open(gi, "w") as fh:
            fh.write("*\n!.gitignore\n")
    return d


def handshake_path():
    return os.path.join(bus_dir(), "bus.json")


def read_msgs():
    out = []
    try:
        with open(STATE["path"]) as fh:
            for i, line in enumerate(fh, 1):
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                    e["_n"] = i
                    out.append(e)
                except ValueError:
                    continue
    except OSError:
        pass
    return out


def append_msg(entry):
    with open(STATE["path"], "a") as fh:
        fh.write(json.dumps(entry) + "\n")


def _now():
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def _apply_run_event(ev):
    """Fold one JSONL event into the in-memory run index."""
    rid = ev.get("id")
    if not rid:
        return
    kind = ev.get("event")
    if kind == "opened":
        run = {
            "id": rid,
            "title": ev.get("title") or "",
            "state": ev.get("state") or "running",
            "opened": ev.get("ts"),
            "stages": [],
            "pauses": [],
        }
        for k in ("role", "harness", "model", "pid"):
            if ev.get(k) not in (None, ""):
                run[k] = ev[k]
        STATE["runs"][rid] = run
        if rid not in STATE["run_ids"]:
            STATE["run_ids"].append(rid)
        return
    run = STATE["runs"].get(rid)
    if not run:
        return
    if kind == "stage":
        rec = {"stage": ev.get("stage"), "ts": ev.get("ts")}
        if ev.get("note"):
            rec["note"] = ev["note"]
        run["stages"].append(rec)
    elif kind == "pid":
        if ev.get("pid") not in (None, ""):
            run["pid"] = ev["pid"]
    elif kind == "paused":
        run["state"] = "paused"
        run["pauses"].append({"start": ev.get("ts")})
    elif kind == "resumed":
        run["state"] = "running"
        if run["pauses"] and "end" not in run["pauses"][-1]:
            run["pauses"][-1]["end"] = ev.get("ts")
    elif kind == "closed":
        outcome = ev.get("outcome")
        run["state"] = outcome
        run["closed"] = ev.get("ts")
        run["outcome"] = outcome
        if ev.get("exit_code") is not None:
            run["exit_code"] = ev["exit_code"]
        if run["pauses"] and "end" not in run["pauses"][-1]:
            run["pauses"][-1]["end"] = ev.get("ts")


def load_runs():
    STATE["runs"] = {}
    STATE["run_ids"] = []
    path = STATE.get("runs_path")
    if not path:
        return
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    _apply_run_event(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass


def append_run(ev):
    with open(STATE["runs_path"], "a") as fh:
        fh.write(json.dumps(ev) + "\n")
    _apply_run_event(ev)


# ---------------------------------------------------------------- ops

def op_register(name, role=None, harness=None, model=None, **_):
    if not name:
        return {"error": "name required"}
    token = secrets.token_urlsafe(16)
    meta = {}
    if role:
        meta["role"] = role
    if harness:
        meta["harness"] = harness
    if model:
        meta["model"] = model
    with LOCK:
        STATE["tokens"][token] = name
        STATE["seen"][name] = time.time()
        # re-register without extras keeps whatever was declared last time
        if meta:
            STATE["meta"][name] = meta
        elif name not in STATE["meta"]:
            STATE["meta"][name] = {}
    return {"ok": True, "name": name, "token": token,
            "session": STATE["session"], "channel": STATE["channel"]}


def whoami(token):
    with LOCK:
        return STATE["tokens"].get(token or "")


def op_send(token, to="all", msg="", topic=None, hops=0, **_):
    sender = whoami(token)
    if not sender:
        return {"error": "unregistered token; call register first"}
    if int(hops or 0) >= MAX_HOPS:
        return {"error": f"loop guard: {MAX_HOPS} hops reached, not delivered"}
    entry = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "from": sender, "to": to or "all",
        "topic": topic, "msg": (msg or "").strip(),
        "hops": int(hops or 0) + 1,
        "session": STATE["session"],
    }
    with NEW_MSG:
        append_msg(entry)
        STATE["seen"][sender] = time.time()
        NEW_MSG.notify_all()
    return {"ok": True, "delivered": entry["to"], "n": len(read_msgs())}


def _match(e, who, since):
    return e["_n"] > since and (not who or e.get("to") in (who, "all"))


def _cursor(all_msgs):
    """Cursor is the highest message number on the channel, not a count of
    matches — passing a match count back as `since` silently re-delivers
    messages you already saw."""
    return all_msgs[-1]["_n"] if all_msgs else 0


def op_read(token=None, to=None, since=0, limit=50, **_):
    who = to or whoami(token)
    everything = read_msgs()
    msgs = [e for e in everything if _match(e, who, int(since or 0))]
    return {"ok": True, "for": who, "count": len(msgs),
            "cursor": _cursor(everything), "messages": msgs[-int(limit):]}


def op_wait(token=None, to=None, since=0, timeout=120, **_):
    who = to or whoami(token)
    since = int(since or 0)
    deadline = time.time() + min(int(timeout or 120), 600)
    with NEW_MSG:
        while True:
            everything = read_msgs()
            msgs = [e for e in everything if _match(e, who, since)]
            if msgs:
                return {"ok": True, "for": who, "cursor": _cursor(everything),
                        "messages": msgs}
            remaining = deadline - time.time()
            if remaining <= 0:
                return {"ok": True, "for": who, "cursor": _cursor(everything),
                        "messages": [], "timeout": True}
            NEW_MSG.wait(min(remaining, 5))


def op_who(**_):
    now = time.time()
    with LOCK:
        agents = [{"name": n, "idle_s": round(now - t, 1)}
                  for n, t in sorted(STATE["seen"].items())]
    return {"ok": True, "session": STATE["session"], "agents": agents}


def _new_run_id():
    for _ in range(8):
        rid = secrets.token_hex(3)
        if rid not in STATE["runs"]:
            return rid
    return secrets.token_hex(4)


def _get_run(rid):
    if not rid:
        return None, {"error": "id required"}
    run = STATE["runs"].get(rid)
    if not run:
        return None, {"error": f"no such run {rid}"}
    return run, None


def _parse_pid(pid):
    if pid in (None, ""):
        return None, None
    try:
        n = int(pid)
    except (TypeError, ValueError):
        return None, {"error": "pid must be an integer"}
    if n <= 0:
        # kill(0, sig) is the process group — never treat 0 as a run pid
        return None, {"error": "pid must be a positive integer"}
    return n, None


def _signal_pid(pid, sig):
    """SIGSTOP/SIGCONT only. A dead or foreign pid must not crash the server."""
    try:
        os.kill(int(pid), sig)
        return None
    except ProcessLookupError:
        return "process is gone"
    except PermissionError:
        return "cannot signal pid (permission denied)"
    except (OSError, ValueError, TypeError, OverflowError) as exc:
        return f"cannot signal pid: {exc}"


def op_run_open(title="", role=None, harness=None, model=None, pid=None, **_):
    title = (title or "").strip()
    if not title:
        return {"error": "title required"}
    pid_val, err = _parse_pid(pid)
    if err:
        return err
    with LOCK:
        rid = _new_run_id()
        ev = {"id": rid, "event": "opened", "ts": _now(),
              "title": title, "state": "running"}
        if role:
            ev["role"] = role
        if harness:
            ev["harness"] = harness
        if model:
            ev["model"] = model
        if pid_val is not None:
            ev["pid"] = pid_val
        append_run(ev)
        return {"ok": True, "id": rid, "run": STATE["runs"][rid]}


def op_run_stage(id=None, stage=None, note=None, **_):
    stage = (stage or "").strip()
    if not stage:
        return {"error": "stage required"}
    with LOCK:
        run, err = _get_run(id)
        if err:
            return err
        if run["state"] in ("complete", "failed"):
            return {"error": f"run {id} is already {run['state']}"}
        ev = {"id": id, "event": "stage", "ts": _now(), "stage": stage}
        if note:
            ev["note"] = note
        append_run(ev)
        return {"ok": True, "id": id, "run": run}


def op_run_pid(id=None, pid=None, **_):
    """Attach a pid to a run that is already open.

    A caller cannot always know the pid at open time: bash learns a child's pid
    only after starting it, and a run id exported after that child starts is not
    inherited by it. Opening first and attaching here breaks that circularity.
    """
    if pid in (None, ""):
        return {"error": "pid required"}
    pid_val, err = _parse_pid(pid)
    if err:
        return err
    with LOCK:
        run, err = _get_run(id)
        if err:
            return err
        if run["state"] in ("complete", "failed"):
            return {"error": f"run {id} is already {run['state']}"}
        append_run({"id": id, "event": "pid", "ts": _now(), "pid": pid_val})
        return {"ok": True, "id": id, "run": run}


def op_run_pause(id=None, **_):
    with LOCK:
        run, err = _get_run(id)
        if err:
            return err
        if run["state"] != "running":
            return {"error": f"run {id} is {run['state']}, not running"}
        pid = run.get("pid")
        if not pid:
            return {"error": "no pid recorded; cannot pause"}
        # signal first: a dead pid must not flip state
        fail = _signal_pid(pid, signal.SIGSTOP)
        if fail:
            return {"error": fail}
        append_run({"id": id, "event": "paused", "ts": _now(), "state": "paused"})
        return {"ok": True, "id": id, "run": run}


def op_run_resume(id=None, **_):
    with LOCK:
        run, err = _get_run(id)
        if err:
            return err
        if run["state"] != "paused":
            return {"error": f"run {id} is {run['state']}, not paused"}
        pid = run.get("pid")
        if not pid:
            return {"error": "no pid recorded; cannot resume"}
        fail = _signal_pid(pid, signal.SIGCONT)
        if fail:
            return {"error": fail}
        append_run({"id": id, "event": "resumed", "ts": _now(), "state": "running"})
        return {"ok": True, "id": id, "run": run}


def op_run_close(id=None, outcome=None, exit_code=None, **_):
    if outcome not in ("complete", "failed"):
        return {"error": "outcome must be complete or failed"}
    code = None
    if exit_code not in (None, ""):
        try:
            code = int(exit_code)
        except (TypeError, ValueError):
            return {"error": "exit_code must be an integer"}
    with LOCK:
        run, err = _get_run(id)
        if err:
            return err
        if run["state"] in ("complete", "failed"):
            return {"error": f"run {id} is already {run['state']}"}
        ev = {"id": id, "event": "closed", "ts": _now(),
              "outcome": outcome, "state": outcome}
        if code is not None:
            ev["exit_code"] = code
        append_run(ev)
        return {"ok": True, "id": id, "run": run}


def op_run_list(limit=None, state=None, **_):
    with LOCK:
        runs = [STATE["runs"][i] for i in STATE["run_ids"] if i in STATE["runs"]]
        if state:
            runs = [r for r in runs if r.get("state") == state]
        if limit not in (None, ""):
            try:
                n = int(limit)
            except (TypeError, ValueError):
                return {"error": "limit must be an integer"}
            if n < 0:
                return {"error": "limit must be >= 0"}
            # runs[-0:] is the full list in Python, so treat 0 as empty
            runs = [] if n == 0 else runs[-n:]
        return {"ok": True, "runs": runs}


def _runs_snapshot():
    """Counts and open runs from the in-memory index — cheap on the poll path."""
    counts = {"running": 0, "paused": 0, "complete": 0, "failed": 0}
    open_runs = []
    complete = closed = 0
    for rid in STATE["run_ids"]:
        r = STATE["runs"].get(rid)
        if not r:
            continue
        st = r.get("state")
        if st in counts:
            counts[st] += 1
        if st in ("running", "paused"):
            open_runs.append(r)
        if st in ("complete", "failed"):
            closed += 1
            if st == "complete":
                complete += 1
    return {"counts": counts, "open": open_runs}, {"complete": complete, "closed": closed}


def _rich_agents():
    now = time.time()
    with LOCK:
        out = []
        for n, t in sorted(STATE["seen"].items()):
            rec = {"name": n, "idle_s": round(now - t, 1)}
            for k, v in (STATE["meta"].get(n) or {}).items():
                if v:
                    rec[k] = v
            out.append(rec)
        return out


def op_status(doctor=1, **_):
    """Everything the dashboard needs, in one call.

    Pass doctor=0 to skip the (slow) health probe and get an instant response.
    """
    want_doctor = doctor
    home = os.path.expanduser("~")
    registry = {}
    try:
        with open(os.path.join(home, ".claude", "orchestrator", "harnesses.json")) as fh:
            registry = json.load(fh)
    except (OSError, ValueError):
        pass

    doctor = None
    if str(want_doctor).lower() not in ("0", "false", "no"):
        cached, when = DOCTOR_CACHE
        if cached is not None and (time.time() - when) < DOCTOR_TTL:
            doctor = cached
        else:
            doc = os.path.join(home, ".claude", "bin", "orchestrator-doctor")
            if os.path.exists(doc):
                try:
                    p = subprocess.run([sys.executable, doc, "--json"],
                                       capture_output=True, text=True, timeout=60)
                    doctor = json.loads(p.stdout)
                    DOCTOR_CACHE[0], DOCTOR_CACHE[1] = doctor, time.time()
                except (OSError, ValueError, subprocess.SubprocessError):
                    doctor = None

    msgs = read_msgs()
    with LOCK:
        runs, rate = _runs_snapshot()
    return {
        "ok": True,
        "session": STATE["session"],
        "channel": STATE["channel"],
        "roles": registry.get("roles", []),
        "default": registry.get("default"),
        "harnesses": registry.get("harnesses", {}),
        "doctor": doctor,
        "agents": _rich_agents(),
        "runs": runs,
        "successRate": rate,
        "messageCount": len(msgs),
        "cursor": _cursor(msgs),
    }


OPS = {"register": op_register, "send": op_send, "read": op_read,
       "wait": op_wait, "who": op_who, "status": op_status}

RUN_OPS = {
    "run_open": op_run_open, "run_stage": op_run_stage, "run_pid": op_run_pid,
    "run_pause": op_run_pause, "run_resume": op_run_resume,
    "run_close": op_run_close, "run_list": op_run_list,
}

