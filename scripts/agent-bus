# ---------------------------------------------------------------- http

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _reply(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if not n:
            return {}
        try:
            return json.loads(self.rfile.read(n))
        except ValueError:
            return {}

    def _runs(self, method, path, payload):
        parts = [p for p in path.split("/") if p]
        if method == "GET" and parts == ["runs"]:
            return op_run_list(**payload)
        if method == "POST" and parts == ["runs"]:
            return op_run_open(**payload)
        if method == "POST" and len(parts) == 3 and parts[0] == "runs":
            fn = {"stage": op_run_stage, "pid": op_run_pid,
                  "pause": op_run_pause, "resume": op_run_resume,
                  "close": op_run_close}.get(parts[2])
            if not fn:
                return None
            payload = dict(payload)
            payload["id"] = parts[1]
            return fn(**payload)
        return None

    def do_GET(self):
        u = urlparse(self.path)
        q = {k: v[0] for k, v in parse_qs(u.query).items()}
        name = u.path.strip("/")
        if name in ("", "index.html"):
            return self._serve_ui()
        if name == "health":
            return self._reply({"ok": True, "session": STATE["session"]})
        if name == "runs" or name.startswith("runs/"):
            result = self._runs("GET", name, q)
            if result is None:
                return self._reply({"error": "not found"}, 404)
            return self._reply(result)
        if name in OPS:
            return self._reply(OPS[name](**q))
        self._reply({"error": "not found"}, 404)

    def _serve_ui(self):
        # realpath, not abspath: this script is normally invoked through the
        # ~/.claude/bin symlink, and abspath would resolve ui/ next to the symlink
        # rather than next to the plugin, serving the placeholder instead.
        root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
        page = os.path.join(root, "ui", "dashboard.html")
        try:
            with open(page, "rb") as fh:
                body = fh.read()
        except OSError:
            body = (b"<title>agent-bus</title><p style='font-family:system-ui;padding:2rem'>"
                    b"No dashboard installed at ui/dashboard.html.</p>")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        u = urlparse(self.path)
        name = u.path.strip("/")

        if name == "mcp":
            return self._mcp(self._body())
        if name == "runs" or name.startswith("runs/"):
            result = self._runs("POST", name, self._body())
            if result is None:
                return self._reply({"error": "not found"}, 404)
            return self._reply(result)
        if name in OPS:
            return self._reply(OPS[name](**self._body()))
        self._reply({"error": "not found"}, 404)

    # ---- minimal MCP over streamable HTTP
    def _mcp(self, req):
        rid = req.get("id")
        method = req.get("method")
        params = req.get("params") or {}

        if method == "initialize":
            return self._reply({"jsonrpc": "2.0", "id": rid, "result": {
                "protocolVersion": PROTOCOL,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "agent-bus", "version": "1.0.0"}}})

        if method and method.startswith("notifications/"):
            self.send_response(202)
            self.send_header("Content-Length", "0")
            self.end_headers()
            return

        if method == "tools/list":
            return self._reply({"jsonrpc": "2.0", "id": rid,
                                "result": {"tools": TOOLS}})

        if method == "tools/call":
            tool = (params.get("name") or "").replace("chat_", "")
            args = params.get("arguments") or {}
            fn = OPS.get(tool) or RUN_OPS.get(tool)
            if not fn:
                return self._reply({"jsonrpc": "2.0", "id": rid, "error": {
                    "code": -32601, "message": f"unknown tool {params.get('name')}"}})
            try:
                result = fn(**args)
            except TypeError as exc:
                result = {"error": f"bad arguments: {exc}"}
            return self._reply({"jsonrpc": "2.0", "id": rid, "result": {
                "content": [{"type": "text", "text": json.dumps(result, indent=2)}],
                "isError": bool(result.get("error"))}})

        self._reply({"jsonrpc": "2.0", "id": rid, "error": {
            "code": -32601, "message": f"unknown method {method}"}})


# ---------------------------------------------------------------- cli

def channel_default():
    try:
        r = subprocess.run(["git", "branch", "--show-current"],
                           capture_output=True, text=True, timeout=5)
        if r.stdout.strip():
            return r.stdout.strip().replace("/", "-")
    except (OSError, subprocess.SubprocessError):
        pass
    return "default"


def serve(args):
    STATE["session"] = args.session or os.environ.get("CLAUDE_SESSION_ID") or "local"
    STATE["channel"] = args.channel or channel_default()
    STATE["path"] = os.path.join(bus_dir(), "board", f"{STATE['channel']}.jsonl")
    STATE["runs_path"] = os.path.join(bus_dir(), "runs", f"{STATE['channel']}.jsonl")
    load_runs()

    try:
        httpd = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    except OSError as exc:
        # Port already bound: another session owns the bus. That is fine —
        # sessions share it and stay separated by channel. Do not fight over it.
        if args.port and getattr(exc, "errno", None) in (48, 98):
            print(f"agent-bus: already running on :{args.port}, reusing", flush=True)
            return
        raise
    port = httpd.server_address[1]
    info = {
        "session": STATE["session"],
        "channel": STATE["channel"],
        "url": f"http://127.0.0.1:{port}",
        "mcp": f"http://127.0.0.1:{port}/mcp",
        "board": STATE["path"],
        "pid": os.getpid(),
    }
    with open(handshake_path(), "w") as fh:
        json.dump(info, fh, indent=2)
    print(json.dumps(info, indent=2), flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        try:
            os.remove(handshake_path())
        except OSError:
            pass


def info(args):
    """Prefer the live server over the on-disk handshake, which may be stale."""
    port = getattr(args, "port", None) or int(os.environ.get("AGENT_BUS_PORT", 8477))
    try:
        r = subprocess.run(["curl", "-fsS", "-m", "3", f"http://127.0.0.1:{port}/status?doctor=0"],
                           capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            d = json.loads(r.stdout)
            print(json.dumps({"session": d.get("session"), "channel": d.get("channel"),
                              "url": f"http://127.0.0.1:{port}",
                              "mcp": f"http://127.0.0.1:{port}/mcp",
                              "messages": d.get("messageCount"),
                              "agents": [a["name"] for a in d.get("agents", [])]}, indent=2))
            return
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    try:
        with open(handshake_path()) as fh:
            print("(server not responding; stale handshake follows)", file=sys.stderr)
            print(fh.read())
    except OSError:
        print(f"no bus on :{port}", file=sys.stderr)
        sys.exit(1)


def stop(args):
    """Stop by port, not by handshake file.

    The handshake lives in the repo the bus was started from, so looking it up
    relative to the current directory misses a bus started anywhere else — and
    the port stays held while `stop` reports success-ish nonsense.
    """
    port = getattr(args, "port", None) or int(os.environ.get("AGENT_BUS_PORT", 8477))
    pids = []
    try:
        r = subprocess.run(["lsof", "-ti", f"tcp:{port}"],
                           capture_output=True, text=True, timeout=10)
        pids = [int(x) for x in r.stdout.split() if x.strip().isdigit()]
    except (OSError, ValueError, subprocess.SubprocessError):
        pass

    if not pids:
        print(f"no bus listening on :{port}")
        sys.exit(1)

    for pid in pids:
        try:
            os.kill(pid, 15)
            print(f"stopped {pid} (port {port})")
        except OSError as exc:
            print(f"could not stop {pid}: {exc}", file=sys.stderr)

    try:
        os.remove(handshake_path())
    except OSError:
        pass


def main():
    ap = argparse.ArgumentParser(prog="agent-bus", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("serve")
    p.add_argument("--session", default=None)
    p.add_argument("--channel", default=None)
    # Fixed by default so the bus can be registered once in .mcp.json — Claude
    # Code connects MCP servers at session start, so an ephemeral port is
    # reachable over REST only. Pass --port 0 if you want ephemeral anyway.
    p.add_argument("--port", type=int, default=int(os.environ.get("AGENT_BUS_PORT", 8477)))
    p.set_defaults(func=serve)
    p = sub.add_parser("info"); p.add_argument("--port", type=int, default=None)
    p.set_defaults(func=info)
    p = sub.add_parser("stop"); p.add_argument("--port", type=int, default=None)
    p.set_defaults(func=stop)
    a = ap.parse_args()
    a.func(a)


if __name__ == "__main__":
    main()
